<?xml version="1.0" encoding="UTF-8"?>
<!-- G5 builds: Maven Central is asked first for plugins and dependencies; the eclipse.org repositories the poms
     declare stay in the list after it (they serve the Eclipse-only artifacts). Local repository: -Dmaven.repo.local. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <profiles>
    <profile>
      <id>central-first</id>
      <repositories>
        <repository>
          <id>central-first</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>central-first</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>central-first</activeProfile>
  </activeProfiles>
</settings>
